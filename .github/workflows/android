name: Build RUPALI Android APK

on:
  workflow_dispatch:

  push:
    paths:
      - "artifacts/rupali/**"
      - "pnpm-lock.yaml"
      - "pnpm-workspace.yaml"
      - ".github/workflows/android.yml"

jobs:
  build:
    name: Build Android Release APK
    runs-on: ubuntu-latest

    steps:
      - name: Checkout source code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 10

      - name: Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android SDK packages
        run: |
          yes | sdkmanager --licenses > /dev/null || true

          sdkmanager --install \
            "platform-tools" \
            "platforms;android-35" \
            "build-tools;35.0.0"

      - name: Install workspace dependencies
        run: pnpm install --frozen-lockfile

      - name: Check RUPALI Expo configuration
        run: |
          node -e "const p=require('./artifacts/rupali/package.json'); console.log('RUPALI main:', p.main)"
          node -e "console.log('Expo:', require('./artifacts/rupali/node_modules/expo/package.json').version)"
          node -e "console.log('Expo Router:', require('./artifacts/rupali/node_modules/expo-router/package.json').version)"

      - name: Install Python model conversion dependency
        run: |
          python -m pip install \
            --disable-pip-version-check \
            torch==2.6.0 \
            --index-url https://download.pytorch.org/whl/cpu

      - name: Download Marathi ONNX model
        run: |
          pnpm --filter @workspace/rupali run fetch-models

      - name: Generate clean Android project
        run: |
          pnpm --filter @workspace/rupali exec expo prebuild \
            --platform android \
            --clean \
            --no-install

      - name: Make Gradle executable
        run: |
          chmod +x artifacts/rupali/android/gradlew

      - name: Build release APK
        working-directory: artifacts/rupali/android
        run: |
          ./gradlew assembleRelease --no-daemon

      - name: Upload APK to GitHub Actions
        uses: actions/upload-artifact@v4
        with:
          name: rupali-marathi-offline-tts
          path: artifacts/rupali/android/app/build/outputs/apk/release/app-release.apk
          if-no-files-found: error
