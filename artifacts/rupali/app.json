{
  "expo": {
    "name": "RUPALI Marathi Offline TTS",
    "slug": "rupali",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rupali",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.rupali.marathitts",
      "versionCode": 1
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
